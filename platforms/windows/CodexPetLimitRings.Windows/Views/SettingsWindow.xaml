<Window x:Class="CodexPetLimitRings.Windows.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Codex 포션 HUD 설정" Width="520" Height="690" MinWidth="480" MinHeight="560"
        Background="#F5F7FB" Foreground="#243047" FontFamily="Segoe UI" WindowStartupLocation="CenterScreen" Closing="Window_OnClosing">
  <Window.Resources>
    <Style TargetType="TextBlock"><Setter Property="Foreground" Value="#243047"/></Style>
    <Style TargetType="Button">
      <Setter Property="Foreground" Value="#334C78"/>
      <Setter Property="Background" Value="#EDF2FA"/>
      <Setter Property="BorderBrush" Value="#D4DEEE"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="10,7"/>
      <Setter Property="Margin" Value="0,4"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value><ControlTemplate TargetType="Button">
          <Border x:Name="ButtonBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="7" Padding="{TemplateBinding Padding}">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ButtonBorder" Property="Background" Value="#DFE9FA"/></Trigger>
            <Trigger Property="IsPressed" Value="True"><Setter TargetName="ButtonBorder" Property="Background" Value="#CEDCF5"/></Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#526FD2"/></Trigger>
            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.5"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate></Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel Margin="22">
      <DockPanel Margin="0,0,0,14">
        <Button DockPanel.Dock="Right" Content="기본값 복원" Click="ResetButton_OnClick" />
        <StackPanel><TextBlock Text="🐱 Codex 포션 HUD" FontSize="21" FontWeight="Bold"/><TextBlock Text="변경 사항은 바로 적용돼요" Foreground="#71717A"/></StackPanel>
      </DockPanel>

      <Border Padding="14" Margin="0,0,0,12" CornerRadius="12" Background="White" BorderBrush="#D4DEEE" BorderThickness="1">
        <StackPanel>
          <TextBlock Text="포션 디자인" FontSize="17" FontWeight="SemiBold"/>
          <TextBlock x:Name="SelectedPotionStyle" Margin="0,3,0,9" Foreground="#52618A" TextWrapping="Wrap"/>
          <ListBox x:Name="PotionStyleChoices" SelectionChanged="PotionStyle_OnChanged" BorderThickness="0" Background="Transparent"
                   ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Disabled"
                   HorizontalContentAlignment="Stretch" AutomationProperties.Name="포션 디자인 선택">
            <ListBox.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="2"/></ItemsPanelTemplate></ListBox.ItemsPanel>
            <ListBox.ItemContainerStyle>
              <Style TargetType="ListBoxItem">
                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                <Setter Property="Margin" Value="3"/>
                <Setter Property="Padding" Value="8"/>
                <Setter Property="ToolTip" Value="{Binding Description}"/>
                <Setter Property="AutomationProperties.Name" Value="{Binding Name}"/>
                <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem">
                  <Border x:Name="Card" Background="#F7F9FC" BorderBrush="#E1E6EF" BorderThickness="2" CornerRadius="9" Padding="{TemplateBinding Padding}">
                    <ContentPresenter/>
                  </Border>
                  <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Card" Property="Background" Value="#EDF2FC"/></Trigger>
                    <Trigger Property="IsSelected" Value="True"><Setter TargetName="Card" Property="Background" Value="#EAF0FF"/><Setter TargetName="Card" Property="BorderBrush" Value="#637EDB"/></Trigger>
                    <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="Card" Property="BorderBrush" Value="#354EA1"/></Trigger>
                  </ControlTemplate.Triggers>
                </ControlTemplate></Setter.Value></Setter>
              </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate><DataTemplate>
              <Grid MinHeight="48">
                <Grid.ColumnDefinitions><ColumnDefinition Width="40"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Grid Width="34" Height="44">
                  <TextBlock Text="◉" FontSize="30" Foreground="#8A70CC" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Preview}" Value="{x:Null}"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                  </TextBlock>
                  <Image Source="{Binding Preview}" Stretch="Uniform"/>
                </Grid>
                <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap" VerticalAlignment="Center" Margin="5,0,0,0"/>
              </Grid>
            </DataTemplate></ListBox.ItemTemplate>
          </ListBox>
          <TextBlock Text="디자인을 선택하면 바로 적용돼요." FontSize="11" Foreground="#71717A" Margin="3,7,0,0"/>
        </StackPanel>
      </Border>

      <Border Padding="16" Margin="0,0,0,12" CornerRadius="12" Background="White" BorderBrush="#E4E4E7" BorderThickness="1">
        <StackPanel>
          <TextBlock Text="배치" FontSize="15" FontWeight="SemiBold"/><TextBlock Text="실제 Codex 펫을 기준으로 위치를 맞춰요." Foreground="#71717A" Margin="0,2,0,12"/>
          <TextBlock Text="펫 기준 정렬"/>
          <ComboBox x:Name="Alignment" Margin="0,5,0,12" SelectionChanged="Control_OnChanged">
            <ComboBoxItem Tag="split" Content="양옆 자동"/>
            <ComboBoxItem Tag="left" Content="펫 왼쪽"/>
            <ComboBoxItem Tag="right" Content="펫 오른쪽"/>
            <ComboBoxItem Tag="above" Content="펫 위쪽"/>
            <ComboBoxItem Tag="below" Content="펫 아래쪽"/>
          </ComboBox>
          <DockPanel><TextBlock Text="가로 위치"/><TextBlock x:Name="HorizontalOffsetValue" DockPanel.Dock="Right" Foreground="#71717A"/></DockPanel>
          <Slider x:Name="HorizontalOffset" Minimum="-400" Maximum="400" TickFrequency="1" ValueChanged="Control_OnChanged"/>
          <DockPanel Margin="0,10,0,0"><TextBlock Text="세로 위치"/><TextBlock x:Name="VerticalOffsetValue" DockPanel.Dock="Right" Foreground="#71717A"/></DockPanel>
          <Slider x:Name="VerticalOffset" Minimum="-300" Maximum="300" TickFrequency="1" ValueChanged="Control_OnChanged"/>
          <UniformGrid Columns="5" Margin="0,12,0,0">
            <Button Content="←" Tag="left" Click="NudgeButton_OnClick" Margin="2" ToolTip="왼쪽 5px"/>
            <Button Content="↑" Tag="up" Click="NudgeButton_OnClick" Margin="2" ToolTip="위 5px"/>
            <Button Content="중앙" Tag="center" Click="NudgeButton_OnClick" Margin="2"/>
            <Button Content="↓" Tag="down" Click="NudgeButton_OnClick" Margin="2" ToolTip="아래 5px"/>
            <Button Content="→" Tag="right" Click="NudgeButton_OnClick" Margin="2" ToolTip="오른쪽 5px"/>
          </UniformGrid>
        </StackPanel>
      </Border>

      <Border Padding="16" Margin="0,0,0,12" CornerRadius="12" Background="White" BorderBrush="#E4E4E7" BorderThickness="1">
        <StackPanel>
          <TextBlock Text="크기와 간격" FontSize="15" FontWeight="SemiBold"/><TextBlock Text="화면과 펫 크기에 맞춰 조절해요." Foreground="#71717A" Margin="0,2,0,12"/>
          <DockPanel><TextBlock Text="전체 크기"/><TextBlock x:Name="ScaleValue" DockPanel.Dock="Right" Foreground="#71717A"/></DockPanel>
          <Slider x:Name="Scale" Minimum="0.5" Maximum="1.8" TickFrequency="0.05" ValueChanged="Control_OnChanged"/>
          <DockPanel Margin="0,10,0,0"><TextBlock Text="포션 간격"/><TextBlock x:Name="PotionGapValue" DockPanel.Dock="Right" Foreground="#71717A"/></DockPanel>
          <Slider x:Name="PotionGap" Minimum="0" Maximum="160" TickFrequency="1" ValueChanged="Control_OnChanged"/>
        </StackPanel>
      </Border>

      <Border Padding="16" Margin="0,0,0,12" CornerRadius="12" Background="White" BorderBrush="#E4E4E7" BorderThickness="1">
        <StackPanel>
          <TextBlock Text="잔여량 알림" FontSize="15" FontWeight="SemiBold"/>
          <CheckBox x:Name="UsageAlerts" Content="포션 알림 사용" Margin="0,10,0,8" Checked="Control_OnChanged" Unchecked="Control_OnChanged"/>
          <WrapPanel>
            <CheckBox x:Name="Alert20" Content="20%" Margin="0,0,18,0" Checked="Control_OnChanged" Unchecked="Control_OnChanged"/>
            <CheckBox x:Name="Alert10" Content="10%" Margin="0,0,18,0" Checked="Control_OnChanged" Unchecked="Control_OnChanged"/>
            <CheckBox x:Name="Alert5" Content="5%" Checked="Control_OnChanged" Unchecked="Control_OnChanged"/>
          </WrapPanel>
          <CheckBox x:Name="NativeNotifications" Content="Windows 알림 배너 표시" Margin="0,10,0,0" Checked="Control_OnChanged" Unchecked="Control_OnChanged"/>
        </StackPanel>
      </Border>

      <Border Padding="16" CornerRadius="12" Background="White" BorderBrush="#E4E4E7" BorderThickness="1">
        <StackPanel>
          <TextBlock Text="저장 공간" FontSize="15" FontWeight="SemiBold"/>
          <CheckBox x:Name="AutoCleanup" Content="매일 앱 캐시 자동 정리" Margin="0,10,0,8" Checked="Control_OnChanged" Unchecked="Control_OnChanged"/>
          <TextBlock x:Name="CleanupStatus" Foreground="#71717A" FontSize="11"/>
          <Button Content="캐시 지금 정리" Click="CleanupButton_OnClick" />
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</Window>
