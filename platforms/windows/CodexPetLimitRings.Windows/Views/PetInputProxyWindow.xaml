<Window x:Class="CodexPetLimitRings.Windows.Views.PetInputProxyWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CodexPetInputProxy"
        Width="112"
        Height="121"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True"
        Focusable="False">
    <!-- Alpha 1 keeps the layered window visually invisible while remaining
         a real Win32 hit target. Fully transparent layered pixels pass through. -->
    <Border Background="#01000000"
            Cursor="SizeAll"
            Focusable="False" />
</Window>
