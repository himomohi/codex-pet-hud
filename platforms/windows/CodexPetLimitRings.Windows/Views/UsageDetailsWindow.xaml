<Window x:Class="CodexPetLimitRings.Windows.Views.UsageDetailsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Codex 포션 상세" Width="340" Height="285" ResizeMode="NoResize"
        WindowStyle="ToolWindow" ShowInTaskbar="False" Topmost="True" Background="#FAFAFA" Closing="Window_OnClosing">
  <Grid Margin="16">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <StackPanel>
      <TextBlock Text="🧪 Codex 포션 상세" FontSize="17" FontWeight="Bold" />
      <TextBlock Text="실제 Codex 펫의 두 사용 한도" Foreground="#71717A" FontSize="11" />
    </StackPanel>
    <Border Grid.Row="1" Margin="0,12,0,5" Padding="10" CornerRadius="9" BorderBrush="#E4E4E7" BorderThickness="1" Background="White">
      <StackPanel><TextBlock Text="🔴 5시간 포션" FontWeight="SemiBold"/><TextBlock x:Name="PrimaryValue" FontSize="20" FontWeight="Bold"/><TextBlock x:Name="PrimaryReset" Foreground="#71717A" FontSize="11"/></StackPanel>
    </Border>
    <Border Grid.Row="2" Margin="0,5,0,12" Padding="10" CornerRadius="9" BorderBrush="#E4E4E7" BorderThickness="1" Background="White">
      <StackPanel><TextBlock Text="🔵 주간 포션" FontWeight="SemiBold"/><TextBlock x:Name="SecondaryValue" FontSize="20" FontWeight="Bold"/><TextBlock x:Name="SecondaryReset" Foreground="#71717A" FontSize="11"/></StackPanel>
    </Border>
    <DockPanel Grid.Row="3">
      <TextBlock x:Name="SourceText" Foreground="#71717A" FontSize="11" VerticalAlignment="Center" />
      <Button x:Name="RefreshButton" DockPanel.Dock="Right" Content="지금 갱신" Click="RefreshButton_OnClick" />
    </DockPanel>
  </Grid>
</Window>
