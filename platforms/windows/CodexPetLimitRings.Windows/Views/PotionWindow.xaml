<Window x:Class="CodexPetLimitRings.Windows.Views.PotionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="92" Height="110" WindowStyle="None" AllowsTransparency="True"
        Background="Transparent" Topmost="True" ShowInTaskbar="False"
        ShowActivated="False" ResizeMode="NoResize">
  <Grid x:Name="Root" Cursor="Hand" MouseLeftButtonUp="Root_OnMouseLeftButtonUp">
    <Ellipse Width="78" Height="78" VerticalAlignment="Top" Margin="0,15,0,0"
             Stroke="#AA8F69" StrokeThickness="6" Fill="#171717">
      <Ellipse.Effect><DropShadowEffect BlurRadius="10" ShadowDepth="5" Opacity="0.45" /></Ellipse.Effect>
    </Ellipse>
    <Ellipse x:Name="Liquid" Width="65" Height="65" VerticalAlignment="Top" Margin="0,21,0,0"
             Stroke="#161616" StrokeThickness="2">
      <Ellipse.Clip><RectangleGeometry x:Name="LiquidClip" Rect="0,65,65,0" /></Ellipse.Clip>
    </Ellipse>
    <Border Width="34" Height="10" VerticalAlignment="Top" Margin="0,5,0,0"
            Background="#201D19" BorderBrush="#AA8F69" BorderThickness="2" CornerRadius="3" />
    <TextBlock x:Name="PercentText" Text="—" Foreground="White" FontSize="14" FontWeight="Bold"
               HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,45,0,0" />
    <Border Width="36" Height="16" VerticalAlignment="Bottom" Margin="0,0,0,3"
            Background="#171717" BorderBrush="#AA8F69" BorderThickness="1" CornerRadius="3">
      <TextBlock x:Name="LabelText" Text="5H" Foreground="White" FontSize="9" FontWeight="Bold"
                 HorizontalAlignment="Center" VerticalAlignment="Center" />
    </Border>
  </Grid>
</Window>
