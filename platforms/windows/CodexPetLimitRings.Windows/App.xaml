<Application x:Class="CodexPetLimitRings.Windows.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnExplicitShutdown">
  <Application.Resources>
    <SolidColorBrush x:Key="CardBrush" Color="#F7F7F8" />
    <SolidColorBrush x:Key="BorderBrush" Color="#E4E4E7" />
    <SolidColorBrush x:Key="MutedBrush" Color="#71717A" />
    <Style TargetType="Button">
      <Setter Property="Padding" Value="12,7" />
      <Setter Property="Margin" Value="0,4,0,4" />
      <Setter Property="Background" Value="#18181B" />
      <Setter Property="Foreground" Value="White" />
      <Setter Property="BorderThickness" Value="0" />
    </Style>
  </Application.Resources>
</Application>
