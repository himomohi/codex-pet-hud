{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://codex-potion-hud.local/schemas/codex-pet-state.json",
  "title": "Codex pet overlay state subset",
  "type": "object",
  "required": ["electron-avatar-overlay-open", "electron-avatar-overlay-bounds"],
  "properties": {
    "electron-avatar-overlay-open": { "type": "boolean" },
    "electron-avatar-overlay-bounds": { "$ref": "#/$defs/persistedBounds" }
  },
  "$defs": {
    "persistedBounds": {
      "type": "object",
      "description": "Producer state accepted by macOS. Windows currently requires the legacy width, height, and mascot or anchor fields.",
      "required": ["x", "y"],
      "properties": {
        "x": { "type": "number" },
        "y": { "type": "number" },
        "width": { "type": "number", "exclusiveMinimum": 0 },
        "height": { "type": "number", "exclusiveMinimum": 0 },
        "displayId": { "type": ["integer", "string"] },
        "displayBounds": { "$ref": "#/$defs/rect" },
        "anchor": { "$ref": "#/$defs/rect" },
        "mascot": { "$ref": "#/$defs/offsetRect" },
        "placement": { "enum": ["top-start", "top-end", "bottom-start", "bottom-end"] },
        "byDisplayId": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/persistedBounds" }
        },
        "byResolution": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/persistedBounds" }
        }
      },
      "additionalProperties": true
    },
    "rect": {
      "type": "object",
      "required": ["x", "y", "width", "height"],
      "properties": {
        "x": { "type": "number" },
        "y": { "type": "number" },
        "width": { "type": "number", "exclusiveMinimum": 0 },
        "height": { "type": "number", "exclusiveMinimum": 0 }
      }
    },
    "offsetRect": {
      "type": "object",
      "required": ["left", "top", "width", "height"],
      "properties": {
        "left": { "type": "number" },
        "top": { "type": "number" },
        "width": { "type": "number", "exclusiveMinimum": 0 },
        "height": { "type": "number", "exclusiveMinimum": 0 }
      }
    }
  },
  "additionalProperties": true
}
